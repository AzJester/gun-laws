{
  "_meta": {
    "description": "Illustrative sample data for the GunLawMap mockup. NOT legal advice and not guaranteed current or accurate. Mirrors docs/DATA-MODEL.md in a flattened form.",
    "generated_for": "concept mockup",
    "schema": {
      "grade": "derived overall grade where A = fewest restrictions and F = most",
      "policies": {
        "permitless_carry": "no permit required to carry",
        "universal_bg_check": "background checks on all sales/transfers",
        "red_flag": "ERPO / red-flag law available",
        "assault_weapon_ban": "state restriction on assault weapons",
        "magazine_limit": "magazine capacity limited",
        "waiting_period": "purchase waiting period required"
      },
      "note": "true/false values are illustrative as of ~2024-2025"
    },
    "sources": [
      "https://www.rand.org/research/gun-policy/tools-and-data.html",
      "https://giffords.org/lawcenter/resources/scorecard/",
      "https://legiscan.com/legiscan",
      "https://docs.openstates.org/api-v3/"
    ],
    "grading": "Grade reflects how FEW restrictions a state imposes (fewer = higher). restrictions = count of the six tracked restriction policies (permit-to-carry counts as a restriction; permitless_carry is its absence). Grade scale by count: 0=A, 1=A-, 2=B, 3=C, 4=D, 5=D-, 6=F. This is the opposite orientation from gun-safety scorecards such as Giffords."
  },
