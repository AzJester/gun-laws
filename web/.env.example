# Copy to `.env` to enable the Postgres-backed data path.
# Leave DATABASE_URL UNSET (or remove .env) to run the app off the JSON
# fallback in src/lib/data.ts — handy for a no-database demo / build.
DATABASE_URL=postgresql://gunlaw:gunlaw@localhost:5432/gunlaw

# --- Ingestion (src/lib/ingest) -------------------------------------------
# Keys for the legislation providers. The ingestion job runs only the
# providers whose key is set; with none it skips gracefully.
#   LegiScan:    https://legiscan.com/legiscan  (register for an API key)
#   Open States: https://open.pluralpolicy.com/accounts/profile/  (API key)
LEGISCAN_API_KEY=
OPENSTATES_API_KEY=

# CourtListener (court feeds). Key OPTIONAL — the free REST API is reachable
# without one, but a token raises the rate limit. Get one at
# https://www.courtlistener.com/profile/
COURTLISTENER_API_TOKEN=

# --- Classifier (LLM draft step, src/lib/ingest/classifier.ts) ------------
# Anthropic key for the classify→draft step. When UNSET, ingestion falls back
# to the deterministic rules classifier (no LLM call, never throws).
ANTHROPIC_API_KEY=
# Model id; defaults to "claude-sonnet-4-6" when unset.
ANTHROPIC_MODEL=

# --- Admin / review (src/app/api/review) ----------------------------------
# Guards the review approve/reject/edit actions. When set, write actions
# require this as a Bearer token (or x-admin-token header). When unset,
# review actions are disabled (nothing publishes).
ADMIN_TOKEN=

# Guards POST /api/ingest. When set, write runs require this as a Bearer token
# (or x-ingest-token header). When unset, the route allows dry runs only.
INGEST_TOKEN=

# --- Alerts / subscriptions (src/lib/email.ts, src/lib/alerts.ts) ---------
# Email provider for double-opt-in confirmations + alert digests. Default
# provider is Resend, called over its HTTP API (no SDK). When UNSET, emails are
# logged to the console and skipped (the app/scripts still run, exit 0).
#   Resend: https://resend.com  (create an API key)
RESEND_API_KEY=
# From address for outgoing mail (defaults to a placeholder when unset).
EMAIL_FROM="GunLawMap Alerts <alerts@gunlawmap.example>"
# Set EMAIL_DRY_RUN=1 (or NODE_ENV=test) to force-skip all sends (no network).
EMAIL_DRY_RUN=

# Public base URL used for confirm/unsubscribe links + RSS self link. When
# unset, the subscribe route falls back to the request origin.
NEXT_PUBLIC_SITE_URL=

# --- Observability / error tracking (src/lib/observability.ts) ------------
# The observability layer is a COMPLETE NO-OP by default: it only logs (single-
# line JSON) and makes NO network call unless SENTRY_DSN is set. There is no
# SDK and no build-time network — safe for both the server build and the static
# `output: export` build.
#
# Optional Sentry DSN. When set, reportError() ALSO POSTs a minimal, Sentry-
# compatible envelope (best-effort, short timeout, failures swallowed). When
# UNSET, errors are logged only — no fetch is attempted. DSN form:
#   https://<publicKey>@<host>/<projectId>
SENTRY_DSN=
# Optional client beacon endpoint for Core Web Vitals (CLS/LCP/INP/FCP/TTFB).
# When set, the WebVitals component navigator.sendBeacon()s metrics there; when
# unset, vitals are logged client-side only. Must be NEXT_PUBLIC_ (client-read).
NEXT_PUBLIC_VITALS_ENDPOINT=
# Optional deploy/commit id surfaced in the boot log + GET /api/health (commit).
# Omitted from the health response when unset.
GIT_SHA=

# NOTE: live error reporting needs egress to your Sentry ingest host. In a
# restricted environment that host must be on the allowlist; otherwise the
# envelope POST fails silently (reportError stays best-effort and never throws).

# --- Rate limiting (src/lib/rate-limit.ts) --------------------------------
# In-memory, per-instance limiter on abuse-prone routes. All optional; the
# defaults below are applied when unset. Values are per client per window.
#   POST /api/subscribe  (default 10 / 10 min)
RATE_LIMIT_SUBSCRIBE=
RATE_LIMIT_SUBSCRIBE_WINDOW_MS=
#   POST /api/ingest     (default 20 / hour)
RATE_LIMIT_INGEST=
RATE_LIMIT_INGEST_WINDOW_MS=
#   POST /api/review/[id] (default 60 / min)
RATE_LIMIT_REVIEW=
RATE_LIMIT_REVIEW_WINDOW_MS=
#   GET  /api/states     (default 120 / min)
RATE_LIMIT_STATES=
RATE_LIMIT_STATES_WINDOW_MS=

# NOTE: live email delivery needs egress to api.resend.com. In a restricted
# environment that host must be on the allowlist, otherwise sends return HTTP
# 403 (the email layer detects this and returns { delivered:false } gracefully).

# NOTE: live runs need egress to api.legiscan.com, v3.openstates.org,
# www.courtlistener.com and api.anthropic.com. In a restricted environment
# those hosts must be on the network allowlist, otherwise calls return HTTP 403
# host_not_allowed (the pipeline detects this and degrades gracefully). See
# web/README.md.
